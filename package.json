  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.5",
    "@vitejs/plugin-vue": "^6.0.9",
    "eslint": "^10.10.0",
