    "typecheck": "node scripts/quality.ts typecheck",
    "lint": "node scripts/quality.ts lint",
    "lint:styles": "node scripts/quality.ts styles",
    "format": "node scripts/quality.ts format",
    "format:check": "node scripts/quality.ts format:check",
    "test": "vitest run",
    "test:watch": "vitest",
